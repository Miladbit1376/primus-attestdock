{
  "name": "attestdock",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm assurance:generate && vite",
    "build": "pnpm check && pnpm server:build && node scripts/assurance.mjs --write-public && vite build",
    "check": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "check:integration": "tsc -p tsconfig.cli.json && node dist-cli/scripts/check.js src/platform server --fail-on high",
    "assurance": "pnpm server:build && node scripts/assurance.mjs",
    "assurance:generate": "pnpm server:build && node scripts/assurance.mjs --write-public",
    "server:dev": "pnpm server:build && node dist-server/server/index.js",
    "server:local": "node --env-file=.env.local dist-server/server/index.js",
    "preview": "vite preview",
    "test": "vitest run",
    "server:build": "tsc -p tsconfig.server.json"
  },
  "dependencies": {
    "@primuslabs/zktls-js-sdk": "0.3.15",
    "ethers": "5.7.2",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "vite": "^8.0.0",
    "vitest": "^4.0.0"
  }
}
