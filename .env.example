# Local platform API is disabled by default. Do not put secrets in VITE_ variables.
ATTESTDOCK_DEV_MODE=0
ATTESTDOCK_PORT=4174

# Set these only in the local server process. No values are committed.
PRIMUS_APP_ID=
PRIMUS_APP_SECRET=

# Reserved for later production services.
DATABASE_URL=
ATTESTDOCK_SESSION_SIGNING_KEY=
ATTESTDOCK_WEBHOOK_ENCRYPTION_KEY=
